# 複製成 .env 後依需求調整。所有值皆可省略，省略則用程式預設。

# Whisper 模型（mlx-community 上的 MLX 版）。要快可改 whisper-base / whisper-small。
WHISPER_MODEL=mlx-community/whisper-large-v3-mlx

# 語言碼（zh / en ...）；留空為自動偵測。
WHISPER_LANGUAGE=

# 人聲分離裝置：mps（Apple GPU）或 cpu。
SEPARATION_DEVICE=mps

# Demucs 模型名稱。
DEMUCS_MODEL=htdemucs

# 預設字幕格式：vtt / srt / both。
DEFAULT_FORMAT=vtt

# ffmpeg 執行檔（在 PATH 內可不設）。
FFMPEG_BIN=ffmpeg
